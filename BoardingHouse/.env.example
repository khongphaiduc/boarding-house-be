# Copy this file to .env at the solution root. Commit only .env.example.
# Restart the API after changing .env.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5154

# LocalDB example (Windows). Use an existing BoardingHouseDB schema.
ConnectionStrings__DefaultConnection='Server=(localdb)\MSSQLLocalDB;Database=BoardingHouseDB;Trusted_Connection=True;TrustServerCertificate=True;'
# SQL Server authentication example; replace the placeholders before using it:
# ConnectionStrings__DefaultConnection='Server=localhost,1433;Database=BoardingHouseDB;User Id=<user>;Password=<password>;TrustServerCertificate=True;'

# List exact frontend origins without a trailing slash; one origin per index.
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173

AllowedHosts=*
Logging__LogLevel__Default=Information
